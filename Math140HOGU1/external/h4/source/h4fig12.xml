<diagram xmlns="https://prefigure.org" dimensions="(600,600)" margins="5">
  <definition>l1(x)=-1/3*x+9</definition>
  <definition>l2(x)=1/3*x+1</definition>
  <definition>l3(x)=15</definition>
  <definition>l4(x)=-4</definition>
  <coordinates bbox="(-2,-4,18,15)">
    <grid-axes spacings="((-1,1,17),(-3,1,14))" xlabel="x" ylabel="y" hlabels="(-1,1,17)" vlabels="(-3,1,14)" hticks="(-1,1,17)" vticks="(-3,1,14)" arrows="2"/>
    <area-between-curves function1="l1" function2="l3" domain="(-2,18)" fill="blue" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l2" function2="l4" domain="(-2,18)" fill="green" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l3" function2="l4" domain="(-2,3)" fill="orange" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l3" function2="l4" domain="(9,18)" fill="orange" stroke="empty" fill-opacity="0.2"/>
    <graph function="l1" domain="(-2,18)" stroke="blue"/>
    <graph function="l2" domain="(-2,18)" stroke="green"/>
    <line endpoints="((3,-4),(3,15))" stroke="red" infinite="yes"/>
    <line endpoints="((9,-4),(9,15))" stroke="orange" infinite="yes"/>
    <point at="point" p="(3,8)" alignment="ne" size="6" fill="black" stroke="black"></point>
    <point at="point" p="(3,2)" alignment="se" size="6" fill="black" stroke="black"></point>
    <point at="point" p="(9,4)" alignment="se" size="6" fill="black" stroke="black"></point>
    <point at="point" p="(9,6)" alignment="ne" size="6" fill="black" stroke="black"></point>
  </coordinates>
</diagram>