<diagram xmlns="https://prefigure.org" dimensions="(800,600)" margins="5">
  <definition>l1(x)=10-x</definition>
  <definition>l2(x)=2*x</definition>
  <definition>l5(x)=-8</definition>
  <definition>l6(x)=0</definition>
  <definition>l7(x)=8</definition>
  <definition>l8(x)=10</definition>
  <coordinates bbox="(-7,-8,11,10)">
    <grid-axes spacings="((-6,1,10),(-7,1,9))" xlabel="x" ylabel="y" hlabels="(-6,1,10)" vlabels="(-7,1,9)" hticks="(-6,1,10)" vticks="(-7,1,9)" arrows="2"/>
    <area-between-curves function1="l7" function2="l8" domain="(-7,11)" fill="blue" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l5" function2="l6" domain="(-7,11)" fill="blue" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l5" function2="l8" domain="(-7,0)" fill="green" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l1" function2="l8" domain="(0,11)" fill="red" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l2" function2="l8" domain="(-4,5)" fill="orange" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l5" function2="l8" domain="(-7,-4)" fill="orange" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l5" function2="l8" domain="(8,11)" fill="orange" stroke="empty" fill-opacity="0.2"/>
    <graph function="l1" domain="(-7,11)" stroke="black"/>
    <graph function="l2" domain="(-7,11)" stroke="black"/>
    <graph function="l7" domain="(-7,11)" stroke="black"/>
    <line endpoints="((8,-8),(8,10))" stroke="black" infinite="yes"/>
    <label anchor="(3.5,3)" alignment="se" color="black"><m>\Huge S</m></label>
  </coordinates>
</diagram>