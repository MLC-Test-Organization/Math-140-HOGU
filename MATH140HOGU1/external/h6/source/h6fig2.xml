<diagram xmlns="https://prefigure.org" dimensions="(600,600)" margins="5">
  <definition>l1(x)=15-1/3*x</definition>
  <definition>l2(x)=40-2*x</definition>
  <definition>l5(x)=-8</definition>
  <definition>l6(x)=0</definition>
  <definition>l7(x)=20</definition>
  <definition>l8(x)=50</definition>
  <definition>l9(x)=-50</definition>
  <coordinates bbox="(-50,-50,50,50)">
    <grid-axes spacings="((-45,5,45),(-45,5,45))" xlabel="x" ylabel="y" hlabels="(-45,5,45)" vlabels="(-45,5,45)" hticks="(-45,5,45)" vticks="(-45,5,45)" arrows="2"/>
    <area-between-curves function1="l1" function2="l8" domain="(-50,50)" fill="orange" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l2" function2="l8" domain="(-5,45)" fill="purple" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l8" function2="l9" domain="(45,50)" fill="purple" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l9" function2="l8" domain="(-50,0)" fill="green" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l9" function2="l8" domain="(18,50)" fill="cyan" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l7" function2="l8" domain="(-50,50)" fill="magenta" stroke="empty" fill-opacity="0.2"/>
    <area-between-curves function1="l9" function2="l6" domain="(-50,50)" fill="red" stroke="empty" fill-opacity="0.2"/>
    <graph function="l1" domain="(-50,50)" stroke="orange"/>
    <graph function="l2" domain="(-50,50)" stroke="purple"/>
    <graph function="l6" domain="(-50,50)" stroke="red"/>
    <graph function="l7" domain="(-50,50)" stroke="magenta"/>
    <graph function="l1" domain="(0,15)" stroke="black"/>
    <graph function="l2" domain="(15,18)" stroke="black"/>
    <graph function="l6" domain="(0,18)" stroke="black"/>
    <line endpoints="((18,-50),(18,50))" stroke="cyan" infinite="yes"/>
    <line endpoints="((0,-50),(0,50))" stroke="green" infinite="yes"/>
    <line endpoints="((18,0),(18,4))" stroke="black" infinite="no"/>
    <line endpoints="((0,0),(0,15))" stroke="black" infinite="yes"/>
    <label anchor="(6,9)" alignment="se" color="black"><m>\Large S</m></label>
    <point p="(0,0)" size="6" fill="black" thickness="0"/>
    <label anchor="(0,0)" alignment="ne" color="black"><m>\large (0,2)</m></label>
    <point p="(0,15)" size="6" fill="black" thickness="0"/>
    <label anchor="(0,15)" alignment="ne" color="black"><m>\large (0,15)</m></label>
    <point p="(15,10)" size="6" fill="black" thickness="0"/>
    <label anchor="(15,10)" alignment="ne" color="black"><m>\large (15,10)</m></label>
    <point p="(18,4)" size="6" fill="black" thickness="0"/>
    <label anchor="(18,4)" alignment="ne" color="black"><m>\large (18,4)</m></label>
    <point p="(18,0)" size="6" fill="black" thickness="0"/>
    <label anchor="(18,0)" alignment="ne" color="black"><m>\large (18,0)</m></label>
  </coordinates>
</diagram>